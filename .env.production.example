# Production Environment Variables Template
# Copy this file to .env.local for local production testing
# Set these variables in your Vercel/Render dashboard for deployment

# NextAuth Configuration
NEXTAUTH_URL=https://your-app-name.vercel.app
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-minimum-32-characters

# Supabase Database
# Get this from Supabase Project Settings → Database → Connection string
# For serverless environments, use connection pooling to avoid prepared statement errors
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Alternative direct connection (use if pooling causes issues):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# Google OAuth Credentials
# Update these in Google Cloud Console with production URLs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Services API Keys
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Web Search API
SERPAPI_API_KEY=your-serpapi-key

# Voice Assistant API
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: Additional Production Settings
# NODE_ENV=production
# VERCEL_URL=your-app-name.vercel.app