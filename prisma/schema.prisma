// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // Pooled connection (for regular queries)
  directUrl = env("DIRECT_URL")   // Direct connection (for migrations & schema)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts       Account[]
  sessions       Session[]
  emails         Email[]
  emailSummaries EmailSummary[]
  scheduledEmails ScheduledEmail[]
  preferences    UserPreferences?
  contacts       Contact[]
  chatMessages   ChatMessage[]
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Email {
  id          String   @id @default(cuid())
  gmailId     String   @unique @map("gmail_id")
  userId      String   @map("user_id")
  threadId    String   @map("thread_id")
  subject     String
  from        String
  to          String[]
  cc          String[] @default([])
  bcc         String[] @default([])
  content     String   @db.Text
  snippet     String?
  labels      String[] @default([])
  isRead      Boolean  @default(false) @map("is_read")
  isStarred   Boolean  @default(false) @map("is_starred")
  isImportant Boolean  @default(false) @map("is_important")
  isSpam      Boolean  @default(false) @map("is_spam")
  isTrash     Boolean  @default(false) @map("is_trash")
  isDraft     Boolean  @default(false) @map("is_draft")
  receivedAt  DateTime @map("received_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaries EmailSummary[]
  
  @@index([userId, gmailId])
  @@index([userId, receivedAt])
  @@index([userId, isRead])
  @@map("emails")
}

model EmailSummary {
  id          String   @id @default(cuid())
  emailId     String   @map("email_id")
  userId      String   @map("user_id")
  summary     String   @db.Text
  keyPoints   String[] @default([]) @map("key_points")
  actionItems String[] @default([]) @map("action_items")
  sentiment   String   @default("neutral")
  priority    String   @default("medium")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([emailId, userId])
  @@index([userId])
  @@map("email_summaries")
}

model UserPreferences {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  autoSummarize   Boolean @default(true) @map("auto_summarize")
  theme           String  @default("light")
  emailsPerPage   Int     @default(50) @map("emails_per_page")
  notifications   Boolean @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

model ScheduledEmail {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  to           String
  cc           String[] @default([])
  bcc          String[] @default([])
  subject      String
  htmlBody     String   @map("html_body") @db.Text
  attachments  Json?    // JSON array of attachment objects
  scheduledAt  DateTime @map("scheduled_at")
  status       String   @default("pending") // pending, processing, sent, failed
  attempts     Int      @default(0)
  lastError    String?  @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  email     String
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, email])
  @@index([userId])
  @@map("contacts")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   // 'user' or 'assistant'
  content   String   @db.Text
  emailId   String?  @map("email_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("chat_messages")
}