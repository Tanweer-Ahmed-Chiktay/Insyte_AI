// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // Pooled connection (for regular queries)
  directUrl = env("DIRECT_DATABASE_URL")   // Direct connection (for migrations & schema)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  historyId     String?   @map("history_id")
  watchExpiration DateTime? @map("watch_expiration")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  accounts         Account[]
  sessions         Session[]
  emails           Email[]
  emailProviders   EmailProvider[]
  emailSummaries   EmailSummary[]
  scheduledEmails  ScheduledEmail[]
  preferences      UserPreferences?
  contacts         Contact[]
  chatMessages     ChatMessage[]
  calendarProviders CalendarProvider[]
  calendarEvents   CalendarEvent[]
  slackWorkspaces  SlackWorkspace[]
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  refresh_token_expires_in Int?
  gmail_history_id  String? @map("gmail_history_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model EmailProvider {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String   // 'gmail', 'outlook', 'imap', 'apple'
  email       String
  isActive    Boolean  @default(true) @map("is_active")
  settings    Json?    // Provider-specific settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]
  
  @@unique([userId, provider, email])
  @@index([userId, isActive])
  @@map("email_providers")
}

model Email {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  externalId      String   @map("external_id") // Gmail ID, Outlook ID, etc.
  userId          String   @map("user_id")
  threadId        String?  @map("thread_id")
  subject         String
  from            String
  to              String[]
  cc              String[] @default([])
  bcc             String[] @default([])
  content         String?  @db.Text
  snippet         String?
  labels          String[] @default([])
  isRead          Boolean  @default(false) @map("is_read")
  isStarred       Boolean  @default(false) @map("is_starred")
  isImportant     Boolean  @default(false) @map("is_important")
  isSpam          Boolean  @default(false) @map("is_spam")
  isTrash         Boolean  @default(false) @map("is_trash")
  isDraft         Boolean  @default(false) @map("is_draft")
  hasAttachments  Boolean  @default(false) @map("has_attachments")
  attachments     Json?    // Attachment metadata
  receivedAt      DateTime @map("received_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     EmailProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  summaries    EmailSummary[]
  
  @@unique([providerId, externalId])
  @@index([userId, receivedAt])
  @@index([userId, isRead])
  @@index([providerId, threadId])
  @@map("emails")
}

model EmailSummary {
  id          String   @id @default(cuid())
  emailId     String   @map("email_id")
  userId      String   @map("user_id")
  summary     String   @db.Text
  keyPoints   String[] @default([]) @map("key_points")
  actionItems String[] @default([]) @map("action_items")
  sentiment   String   @default("neutral")
  priority    String   @default("medium")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([emailId, userId])
  @@index([userId])
  @@map("email_summaries")
}

model UserPreferences {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  autoSummarize   Boolean @default(true) @map("auto_summarize")
  theme           String  @default("light")
  emailsPerPage   Int     @default(50) @map("emails_per_page")
  notifications   Boolean @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

model ScheduledEmail {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  to           String
  cc           String[] @default([])
  bcc          String[] @default([])
  subject      String
  htmlBody     String   @map("html_body") @db.Text
  attachments  Json?    // JSON array of attachment objects
  scheduledAt  DateTime @map("scheduled_at")
  status       String   @default("pending") // pending, processing, sent, failed
  attempts     Int      @default(0)
  lastError    String?  @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("scheduled_emails")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  email     String
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, email])
  @@index([userId])
  @@map("contacts")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   // 'user' or 'assistant'
  content   String   @db.Text
  emailId   String?  @map("email_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("chat_messages")
}

model CalendarProvider {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String   // 'google', 'outlook', 'apple'
  email       String
  isActive    Boolean  @default(true) @map("is_active")
  settings    Json?    // Provider-specific settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]
  
  @@unique([userId, provider, email])
  @@index([userId, isActive])
  @@map("calendar_providers")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  externalId  String   @map("external_id") // Google Event ID, Outlook Event ID, etc.
  userId      String   @map("user_id")
  title       String
  description String?  @db.Text
  location    String?
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  isAllDay    Boolean  @default(false) @map("is_all_day")
  attendees   Json?    // Array of attendee objects
  recurrence  Json?    // Recurrence rules
  status      String   @default("confirmed") // confirmed, tentative, cancelled
  visibility  String   @default("default") // default, public, private
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider CalendarProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, externalId])
  @@index([userId, startTime])
  @@index([providerId, startTime])
  @@map("calendar_events")
}

model SlackWorkspace {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  teamId      String   @map("team_id")
  teamName    String   @map("team_name")
  isActive    Boolean  @default(true) @map("is_active")
  accessToken String   @map("access_token") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels SlackChannel[]
  messages SlackMessage[]
  
  @@unique([userId, teamId])
  @@index([userId, isActive])
  @@map("slack_workspaces")
}

model SlackChannel {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  channelId   String   @map("channel_id")
  name        String
  isPrivate   Boolean  @default(false) @map("is_private")
  isMember    Boolean  @default(false) @map("is_member")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  workspace SlackWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  SlackMessage[]
  
  @@unique([workspaceId, channelId])
  @@index([workspaceId, isMember])
  @@map("slack_channels")
}

model SlackMessage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  channelId   String   @map("channel_id")
  messageId   String   @map("message_id")
  userId      String?  @map("user_id")
  username    String?
  text        String   @db.Text
  timestamp   DateTime
  threadTs    String?  @map("thread_ts")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  workspace SlackWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   SlackChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, channelId, messageId])
  @@index([workspaceId, channelId, timestamp])
  @@map("slack_messages")
}